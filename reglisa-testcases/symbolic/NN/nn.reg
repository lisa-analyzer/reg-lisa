x00 := 0;
x01 := 1;
c := 0;
pf := -1;

x10 := 1.0 * x00 + 1.0 * x01 + 4;
x11 := 0.5 * x00 + 0.5 * x01 + 3;

(x10 < 0 ?; x10 := 0);
(x11 < 0 ?; x11 := 0);

x20 := 2.0 * x10 + 3.0 * x11;
x21 := 1.0 * x10 - 1.0 * x11;

(x20 < 0 ?; x20 := 0);
(x21 < 0 ?; x21 := 0);

x30 := 1.0 * x20 - 1.0 * x21 - 14;
x31 := 0.5 * x20 - 1.5 * x21 - 8;

x00 := x30;
x01 := x31;

c := c+1;

(
    c < 3 ?; 

    x10 := 1.0 * x00 + 1.0 * x01 + 4;
    x11 := 0.5 * x00 + 0.5 * x01 + 3;

    (x10 < 0 ?; x10 := 0);
    (x11 < 0 ?; x11 := 0);

    x20 := 2.0 * x10 + 3.0 * x11;
    x21 := 1.0 * x10 - 1.0 * x11;

    (x20 < 0 ?; x20 := 0);
    (x21 < 0 ?; x21 := 0);

    x30 := 1.0 * x20 - 1.0 * x21 - 14;
    x31 := 0.5 * x20 - 1.5 * x21 - 8;

    x00 := x30;
    x01 := x31;

    c := c+1;
)*;

( x30 > x31 ?; pf := 1 );
( x30 <= x31 ?; pf := 0);